# TrustRent — root environment example (used by scripts/deployment & scripts/seed)
# Copy to `.env` locally. NEVER commit real secrets.

# Stellar network — development uses Testnet only (never mainnet).
SOROBAN_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Account that signs deployment transactions. Create one on testnet via
# `soroban keys generate` or the Stellar Laboratory.
SOROBAN_SECRET_KEY=

# Off-chain evidence storage provider. Phase 1 ships a `local`/memory provider.
# See docs/storage.md. Chosen via Gravity Index when integrating for real.
STORAGE_PROVIDER=local
