# TrustRent web app — environment example (copy to `.env.local`)
# Stellar Testnet only during development.

NEXT_PUBLIC_SOROBAN_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Contract IDs are filled in during phase 2 (see scripts/deployment).
NEXT_PUBLIC_AGREEMENT_CONTRACT_ID=
NEXT_PUBLIC_ESCROW_CONTRACT_ID=
NEXT_PUBLIC_DISPUTE_CONTRACT_ID=

# Off-chain evidence storage provider ("local" in phase 1; see docs/storage.md).
NEXT_PUBLIC_STORAGE_PROVIDER=local
